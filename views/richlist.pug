extends layout

block content
  //- Wealth distribution, drawn with the same library as every other chart
  //- here since #29. It was jqPlot 1.9pre -- last released in 2013, loaded on
  //- every page of the site for this one pie, and its colours were literals
  //- that predate the brand palette.
  //-
  //- The old resize handler called replot() on a variable declared inside the
  //- ready callback, so it threw on every resize; Chart.js is responsive on
  //- its own and needs no handler at all.

  .row
    .col-xs-12.col-md-8
      .tabpanel
        ul.nav.nav-tabs(role='tablist')
          li.nav-item(role='presentation')
            a.nav-link.active(href='#balance', aria-controls='balance', role='tab', data-toggle='tab') Balance
          li.nav-item(role='presentation')
            a.nav-link(href='#received', aria-controls='received', role='tab', data-toggle='tab') Received
      .tab-content
        #balance.tabpanel.tab-pane.active 
          include ./includes/rl_balance.pug
        #received.tabpanel.tab-pane
          include ./includes/rl_received.pug
    if show_dist == true
      .col-md-4.col-xs-12
        #summary-panel.card.card-default(style='margin-top:47px;')
          .card-header
            h5.card-title #{settings.locale.rl_wealth}
          table.table.table-hover.table-bordered
            thead
              tr
                th
                th Amount (#{settings.symbol})
                th.text-center %
            tbody
              tr
                th
                  span.richlist-swatch(class='richlist-swatch-1')
                  span #{settings.locale.rl_top25}
                - var total = parseFloat(dista.total).toLocaleString('en',{'minimumFractionDigits':2,'maximumFractionDigits':8,'useGrouping':true})
                td #{total}
                td.text-center #{parseFloat(dista.percent).toFixed(2)}
              tr
                th
                  span.richlist-swatch(class='richlist-swatch-2')
                  span #{settings.locale.rl_top50}
                - var total = parseFloat(distb.total).toLocaleString('en',{'minimumFractionDigits':2,'maximumFractionDigits':8,'useGrouping':true})
                td #{total}
                td.text-center #{parseFloat(distb.percent).toFixed(2)}
              tr
                th
                  span.richlist-swatch(class='richlist-swatch-3')
                  span #{settings.locale.rl_top75}
                - var total = parseFloat(distc.total).toLocaleString('en',{'minimumFractionDigits':2,'maximumFractionDigits':8,'useGrouping':true})
                td #{total}
                td.text-center #{parseFloat(distc.percent).toFixed(2)}
              tr
                th
                  span.richlist-swatch(class='richlist-swatch-4')
                  span #{settings.locale.rl_top100}
                - var total = parseFloat(distd.total).toLocaleString('en',{'minimumFractionDigits':2,'maximumFractionDigits':8,'useGrouping':true})
                td #{total}
                td.text-center #{parseFloat(distd.percent).toFixed(2)}
              tr
                th
                  span #{settings.locale.total}
                td 
                td.text-center #{(100 - parseFloat(distd.percent)).toFixed(2)}
        center
          .richlist-chart
            canvas#pieChart(role='img', aria-label=settings.locale.rl_wealth)
      -
        var wealth = [
          {label: 'Top 1-25',  value: parseFloat(dista.percent)},
          {label: 'Top 26-50', value: parseFloat(distb.percent)},
          {label: 'Top 51-75', value: parseFloat(distc.percent)},
          {label: 'Top 76-100', value: parseFloat(distd.percent)},
          {label: '101+', value: parseFloat(diste.percent)}
        ];
      script
        != 'window.WEALTH_DIST = ' + JSON.stringify(wealth) + ';'
      script(src='/vendor/chartjs/chart.umd-4.5.1.min.js')
      script(src='/javascripts/richlist-chart.js?v=' + settings.asset_version)
  .row.footer-margin