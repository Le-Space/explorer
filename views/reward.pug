extends layout

//- The reward page, for chains running the `heavy` extensions.
//-
//- Its two charts were the only remaining users of the Chart.js 1.x API --
//- `new Chart(ctx).Doughnut(data)`, which has not been the interface since
//- 2016 and was loaded on every page of the site to serve this one. They are
//- Chart.js 4 now, like everything else since #29.
//-
//- The data crosses into JavaScript as one object instead of being
//- interpolated value by value into the script body, which is how a twenty-
//- element series used to be written out twenty times over.

block content
  if !heavy
    .col-md-12(style="margin-bottom: 4%")
      .card.card-default
        .card-header
          strong #{settings.locale.heavy_title}
        .card-body
          p #{settings.locale.heavy_unavailable}
  else
    .row(style='margin-top:5px;')
      .col-md-12(style='text-align:center;')
        img(src='/images/logo.png' style='width:80px;margin: 0px auto 15px auto;')
    .row
      .col-xs-12.col-md-12
        .card.card-default.card-address-summary
          .card-header(style='position:relative;')
            strong #{settings.locale.heavy_title} (#{settings.symbol})
          table.table.table-bordered.table-striped.summary-table
            thead
              tr
                th #{settings.locale.ex_supply} (#{settings.symbol})
                th #{settings.locale.heavy_cap} (#{settings.symbol})
                th #{settings.locale.heavy_phase}
                th #{settings.locale.heavy_maxvote}
                th #{settings.locale.heavy_reward}
                th #{settings.locale.heavy_estnext}
            tbody
              tr
                td= heavy.supply
                td= heavy.cap
                td= heavy.phase
                td= heavy.maxvote
                td= heavy.reward
                td= heavy.estnext
    .row
      .col-md-12
        .card.card-default
          .card-body
            .row
              .col-md-3
                center
                  .reward-donut
                    canvas#rewardCycle(role='img', aria-label=settings.locale.heavy_changein)
                  h5 #{settings.locale.heavy_changein}
                  h5= heavy.nextin

                table.table.reward-legend
                  tbody
                    tr
                      th #{settings.locale.heavy_vote}
                      td
                        span.reward-swatch.reward-swatch-vote
                    tr
                      th #{settings.locale.heavy_current}
                      td
                        span.reward-swatch.reward-swatch-current
                    tr
                      th #{settings.locale.heavy_estnext}
                      td
                        span.reward-swatch.reward-swatch-next

              .col-md-9
                center
                  .row
                    strong #{settings.locale.heavy_lastxvotes}
                  .reward-chart
                    canvas#rewardVotes(role='img', aria-label=settings.locale.heavy_lastxvotes)

    -
      var rewardData = {
        //- Where the chain stands inside the current 3600-block cycle. The old
        //- code computed this in the template as ((count/3600)%1)*100; it is
        //- the same arithmetic, done once and named.
        cyclePercent: ((((stats && stats.count) || 0) / 3600) % 1) * 100,
        labels: (votes || []).map(function (v) { return v.count; }),
        votes: (votes || []).map(function (v) { return v.vote; }),
        rewards: (votes || []).map(function (v) { return v.reward; }),
        i18n: {
          vote: settings.locale.heavy_vote,
          reward: settings.locale.heavy_reward,
          elapsed: settings.locale.heavy_changein
        }
      };
    script
      != 'window.REWARD_DATA = ' + JSON.stringify(rewardData) + ';'
    script(src='/vendor/chartjs/chart.umd-4.5.1.min.js')
    script(src='/javascripts/reward-chart.js?v=' + settings.asset_version)
